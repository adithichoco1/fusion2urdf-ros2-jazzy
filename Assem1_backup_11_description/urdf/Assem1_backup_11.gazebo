<?xml version="1.0" ?>
<robot name="Assem1_backup_11" xmlns:xacro="http://www.ros.org/wiki/xacro" >

<gazebo>
  <plugin name="gz_ros2_control::GazeboSimROS2ControlPlugin" filename="libgz_ros2_control-system.so">
    <parameters>$(find Assem1_backup_11_description)/config/controllers.yaml</parameters>
  </plugin>
</gazebo>
<gazebo reference="base_link">
  <self_collide>true</self_collide>
  <gravity>true</gravity>
</gazebo>

<gazebo reference="link2_1">
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="link4_1">
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="link5_1">
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="link6_1">
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="link7_2">
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="link7_1">
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="link3_1">
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="link1_1">
  <self_collide>true</self_collide>
</gazebo>

</robot>
