<?xml version="1.0" ?>
<robot name="Assem1_backup_8" xmlns:xacro="http://www.ros.org/wiki/xacro" >

<gazebo>
  <plugin name="gz_ros2_control::GazeboSimROS2ControlPlugin" filename="libgz_ros2_control-system.so">
    <parameters>$(find Assem1_backup_8_description)/config/controllers.yaml</parameters>
  </plugin>
</gazebo>
<gazebo reference="base_link">
  <visual>
    <material>
      <ambient>0.7 0.7 0.7 1</ambient>
      <diffuse>0.7 0.7 0.7 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
    </material>
  </visual>
  <collision>
    <surface>
      <friction>
        <ode>
          <mu>0.2</mu>
          <mu2>0.2</mu2>
        </ode>
      </friction>
    </surface>
  </collision>
  <self_collide>true</self_collide>
  <gravity>true</gravity>
</gazebo>

